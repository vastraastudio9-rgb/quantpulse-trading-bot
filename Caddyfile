{$APP_DOMAIN:localhost} {
	encode zstd gzip

	# Generate with: caddy hash-password --plaintext 'your-long-password'
	basicauth {
		{$ADMIN_USER:operator} {$ADMIN_PASSWORD_HASH}
	}

	@engine path /health /metrics /api/*
	handle @engine {
		reverse_proxy 127.0.0.1:3030 {
			header_up X-Operator-Token {$OPERATOR_TOKEN}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
