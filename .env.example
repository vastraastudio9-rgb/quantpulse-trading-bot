# Public hostname used by Caddy, e.g. trade.example.com. Use localhost locally.
APP_DOMAIN=localhost
ADMIN_USER=operator
# Required: output from `caddy hash-password --plaintext "your password"`
ADMIN_PASSWORD_HASH=

DATABASE_URL=file:./db/custom.db
CORS_ORIGINS=http://localhost:3000
ENGINE_HOST=127.0.0.1
ENGINE_PORT=3030
LOG_LEVEL=info
FORWARDED_ALLOW_IPS=127.0.0.1
REQUIRE_OPERATOR_TOKEN=true
OPERATOR_TOKEN=

# Safety default. Live trading must not be enabled until broker-specific review.
TRADING_MODE=PAPER
ALLOW_LIVE_TRADING=false

# Optional integrations. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
